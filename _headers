# Cloudflare Workers Assets — response headers.
# Syntax: a path pattern, then indented "Header: value" lines.
#
# IMPORTANT — how overlapping rules resolve:
# A request matching several patterns inherits ALL of their headers, and a
# header set by two matching rules is joined with a comma rather than the more
# specific rule winning. A request for /admin/login.html matches both /* and
# /admin/* below, so simply restating Content-Security-Policy and
# X-Frame-Options in the /admin/* block emits TWO of each header — browsers
# then enforce the intersection of both CSPs, which is not what is intended.
#
# The fix is the documented "detach a header" syntax: a header name prefixed
# with "! " removes the value inherited from a more pervasive rule. Detaching
# and then setting a new value in the same block yields exactly one header.
# Verified against `wrangler dev`: /admin/login returns a single
# content-security-policy (frame-ancestors 'none') and a single
# x-frame-options (DENY), while / returns 'self' / SAMEORIGIN.
# https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  # NOTE: 'unsafe-inline' in script-src is required because every page carries
  # inline <script> blocks and inline JSON-LD, and a static host cannot mint
  # per-request nonces. This CSP therefore does NOT stop injected inline
  # handlers — that class of bug is fixed at the source by escapeHtml(). What it
  # does buy: no script can be loaded from an origin outside the allowlist below,
  # no <object>/<embed>, no <base> hijack, and forms cannot post off-site.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://hvesaitxkwlufbljnupy.supabase.co https://www.google-analytics.com; connect-src 'self' https://hvesaitxkwlufbljnupy.supabase.co https://www.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'

# The admin area must never be framed, indexed, or cached.
#
# The two "! " lines detach the /* values above so these replace rather than
# stack. The CSP is a full restatement of the /* policy with frame-ancestors
# swapped to 'none' — keep the two in sync when either changes.
/admin/*
  ! X-Frame-Options
  X-Frame-Options: DENY
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://hvesaitxkwlufbljnupy.supabase.co https://www.google-analytics.com; connect-src 'self' https://hvesaitxkwlufbljnupy.supabase.co https://www.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# Fingerprint-free static assets. Keep this moderate rather than immutable:
# filenames are not content-hashed, so a long TTL would strand an updated logo
# or stylesheet in visitors' caches. /* sets no Cache-Control, so these do not
# stack with anything.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# styles.css is linked as css/styles.css?v=N from all 13 HTML files, and that
# N MUST be incremented whenever the file changes. The TTL below is why: HTML
# is not cached, so new markup otherwise meets a stylesheet up to a day old
# (a week, counting stale-while-revalidate). That mismatch shipped a visibly
# broken reviews section on 2026-09-05 — see the block at the top of
# css/styles.css for the procedure and the incident.
#
# The bump works on the visitor's browser, which keys its cache on the full URL
# including the query. Cloudflare's edge normalises the query away here, so
# ?v=2 and ?v=99 both hit the same cached object — harmless, since the edge is
# refreshed by each deploy and was never the layer that served stale CSS.
/css/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
