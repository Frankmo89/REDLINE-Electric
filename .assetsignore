# Files in the repo root that must NOT be published as static assets.
# wrangler.jsonc sets assets.directory to "./", so without this every tracked
# file at the root would be fetchable (e.g. /wrangler.jsonc, /assets/photos/TODO.txt).
wrangler.jsonc
.gitattributes
.gitignore
.assetsignore
# Internal working notes. Was served publicly (200 on /PENDING.md) until
# 2026-08-21 and quotes the personal email address that item 2 deliberately
# removed from the public site on 2026-08-17.
PENDING.md
**/.git
**/.claude
**/node_modules
**/.DS_Store
assets/photos/TODO.txt
# Developer tooling. Neither is needed to SERVE the site, but both were being
# served: assets.directory is "./", so a directory is published unless it is
# named here -- which is why the supabase/ entry below exists too.
# /hooks/pre-commit was publicly fetchable until this entry was added.
hooks/
scripts/
# Supabase Edge Function source, vendored for version control only. It is
# deployed to Supabase, never served by the Worker, and contains the internal
# notification recipient -- publishing it would put that address back on the
# public site.
supabase/
